        <mxCell id="e13" edge="1" source="step10" target="dec2" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decision 2: OK / NA / Not OK -->
        <mxCell id="e14_ok" value="OK" edge="1" source="dec2" target="status_ok" parent="1" style="strokeColor=#16a34a;fontColor=#16a34a;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14_na" value="N/A" edge="1" source="dec2" target="status_na" parent="1" style="strokeColor=#64748b;fontColor=#64748b;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14_not_ok" value="Not OK" edge="1" source="dec2" target="status_not_ok" parent="1" style="strokeColor=#dc2626;fontColor=#dc2626;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e15" edge="1" source="status_not_ok" target="defect_details" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" edge="1" source="defect_details" target="dec3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decision 3: On-Spot Closure -->
        <mxCell id="e17_spot" value="YES (Closed)" edge="1" source="dec3" target="on_spot_corr" parent="1" style="strokeColor=#16a34a;fontColor=#16a34a;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17_open" value="NO (Open)" edge="1" source="dec3" target="open_defect" parent="1" style="strokeColor=#dc2626;fontColor=#dc2626;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e18_a" edge="1" source="status_ok" target="dec4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18_b" edge="1" source="status_na" target="dec4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
