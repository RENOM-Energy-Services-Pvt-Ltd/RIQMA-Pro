        <mxCell id="e18_d" edge="1" source="open_defect" target="dec4" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decision 4: Completeness (Back-Cycle 1) -->
        <mxCell id="e19_pend" value="NO (Pending)" edge="1" source="dec4" target="pending_list" parent="1" style="strokeColor=#dc2626;fontColor=#dc2626;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19_loop" value="BACK-CYCLE: Return to Complete Pending Checkpoints" edge="1" source="pending_list" target="step10" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#dc2626;dashed=1;dashPattern=8 8;fontColor=#dc2626;fontStyle=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="65" y="1640" /><mxPoint x="65" y="1002" /></Array></mxGeometry></mxCell>

        <mxCell id="e20_done" value="YES (100% Done)" edge="1" source="dec4" target="self_review" parent="1" style="strokeColor=#16a34a;fontColor=#16a34a;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" edge="1" source="self_review" target="dec5" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Decision 5: Network Speed -->
        <mxCell id="e22_weak" value="NO (Weak / Offline)" edge="1" source="dec5" target="weak_net" parent="1" style="strokeColor=#64748b;fontColor=#64748b;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22_good" value="YES (Good Speed)" edge="1" source="dec5" target="step20" parent="1" style="strokeColor=#16a34a;fontColor=#16a34a;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

