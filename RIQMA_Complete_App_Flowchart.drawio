        <mxCell id="e_mgr_loop" value="BACK-CYCLE: Manager Returns for Correction -&gt; Auditor Re-opens Self-Review Screen" edge="1" source="m_correction" target="w_step1" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#dc2626;strokeWidth=2.5;dashed=1;dashPattern=8 8;fontColor=#dc2626;fontStyle=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1285" y="2380" /><mxPoint x="1255" y="2380" /><mxPoint x="1255" y="1785" /></Array></mxGeometry></mxCell>

