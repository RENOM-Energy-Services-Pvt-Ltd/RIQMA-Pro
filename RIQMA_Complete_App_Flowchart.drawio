        <mxCell id="we7_loop" edge="1" source="fix_fields" target="w_step2" parent="web_auditor_box" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#dc2626;dashed=1;fontColor=#dc2626;fontStyle=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15" y="842" /><mxPoint x="15" y="195" /></Array></mxGeometry></mxCell>
        <mxCell id="we8_ok" value="YES" edge="1" source="dec_rules" target="w_submit" parent="web_auditor_box" style="strokeColor=#16a34a;fontColor=#16a34a;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="we9" edge="1" source="w_submit" target="auto_score" parent="web_auditor_box"><mxGeometry relative="1" as="geometry" /></mxCell>

