        <mxCell id="e_to_mgr" value="Submitted to Manager" edge="1" source="auto_score" target="m_dash" parent="1" style="strokeColor=#1e3a8a;strokeWidth=2;fontColor=#1e3a8a;fontStyle=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="me1" edge="1" source="m_dash" target="m_review_screen" parent="web_mgr_box"><mxGeometry relative="1" as="geometry" /></mxCell>
